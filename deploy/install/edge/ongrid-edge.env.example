# ongrid-edge environment file - rendered by install-edge.sh to
# /etc/ongrid-edge/ongrid-edge.env. The systemd unit reads this via
# EnvironmentFile=. The ongrid-edge binary consumes these env vars directly
# (see internal/pkg/config/config.go: ONGRID_EDGE_CLOUD_ADDR / _ACCESS_KEY /
# _SECRET_KEY).

ONGRID_EDGE_CLOUD_ADDR=__CLOUD_ADDR__
ONGRID_EDGE_ACCESS_KEY=__ACCESS_KEY__
ONGRID_EDGE_SECRET_KEY=__SECRET_KEY__
ONGRID_EDGE_COLLECTOR_MODE=auto
ONGRID_EDGE_SCRAPE_CONFIG_FILE=/etc/ongrid-edge/scrape.yaml
ONGRID_EDGE_COLLECTOR_INTERVAL=10s

# Optional fixed diagnostics address. Unset/blank: prefer :9101 and let the
# OS allocate a free port if occupied. Explicit addresses never fall back.
# ONGRID_EDGE_METRICS_ADDR=:19101

# ---- Local listener ports (host Edge) ---------------------------------
# Every port the Edge or its plugin subprocesses bind locally can be moved.
# Unset/blank keeps the default shown. Values are host:port or :port
# (all interfaces). Explicit plugin specs from the Manager still win.
# Startup fails with a clear error on malformed values or port conflicts.
# The installers preserve these lines on reinstall.
# ONGRID_EDGE_PPROF_ADDR=127.0.0.1:16060          # "off" disables pprof
# ONGRID_EDGE_HOSTMETRICS_ADDR=:9102              # node_exporter
# ONGRID_EDGE_PROCMETRICS_ADDR=:9256              # process-exporter
# ONGRID_EDGE_TRACES_GRPC_ADDR=127.0.0.1:4317     # OTLP gRPC for applications
# ONGRID_EDGE_TRACES_HTTP_ADDR=127.0.0.1:4318     # OTLP HTTP for applications
# ONGRID_EDGE_TRACES_HEALTH_ADDR=127.0.0.1:13133
# ONGRID_EDGE_TRACES_TELEMETRY_ADDR=127.0.0.1:8888
# ONGRID_EDGE_TRACES_APP_METRICS_ADDR=127.0.0.1:9464
# ONGRID_EDGE_LOGS_HEALTH_ADDR=127.0.0.1:13134
# ONGRID_EDGE_LOGS_TELEMETRY_ADDR=127.0.0.1:8889
# ONGRID_EDGE_AUTOAPM_GRPC_ADDR=127.0.0.1:14317
# ONGRID_EDGE_AUTOAPM_HTTP_ADDR=127.0.0.1:14318
# ONGRID_EDGE_AUTOAPM_HEALTH_ADDR=127.0.0.1:14333
# ONGRID_EDGE_AUTOAPM_TELEMETRY_ADDR=127.0.0.1:18888
# ONGRID_EDGE_AUTOAPM_METRICS_ADDR=127.0.0.1:9465

# ---- Passive network discovery --------------------------------------
# Enabled by default. Set false to stop reporting local gateway, ARP, and
# LLDP neighbors as candidates for operator-controlled SNMP verification.
ONGRID_NETWORK_DISCOVERY_ENABLED=true
ONGRID_NETWORK_DISCOVERY_INTERVAL=1m

# ---- Plugin runtime (ADR-015) ----------------------------------------
# Edge ID is needed by every plugin to inject the `edge_id` label set on
# outbound telemetry. Empty by default — plugins refuse to render config
# until operator sets this (auto-discovered ID will land here in PR-C2).
ONGRID_EDGE_ID=

# ---- Logs plugin (ADR-012) -------------------------------------------
# Off by default. Set ENABLED=true + ENDPOINT=https://<manager>/loki/api/v1/push
# to start shipping journald + file tail logs. AUTH_USER / AUTH_PASS
# default to the tunnel ACCESS_KEY / SECRET_KEY above (data plane and
# control plane share credentials per ADR-014 §决策第 2 条).
ONGRID_EDGE_PLUGIN_LOGS_ENABLED=false
ONGRID_EDGE_PLUGIN_LOGS_ENDPOINT=
# ONGRID_EDGE_PLUGIN_LOGS_AUTH_USER=  # defaults to ONGRID_EDGE_ACCESS_KEY
# ONGRID_EDGE_PLUGIN_LOGS_AUTH_PASS=  # defaults to ONGRID_EDGE_SECRET_KEY
# Spec is JSON; control which sources are tailed.
# ONGRID_EDGE_PLUGIN_LOGS_SPEC_JSON={"file_paths":["/var/log/syslog"]}
